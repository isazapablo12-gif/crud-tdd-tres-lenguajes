{
  "name": "crud-tdd-javascript-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "express": "5.2.1",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "5.0.0",
    "@vue/test-utils": "2.5.0",
    "concurrently": "10.0.5",
    "jsdom": "30.0.1",
    "supertest": "7.2.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}

