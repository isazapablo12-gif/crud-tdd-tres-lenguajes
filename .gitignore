# Sistemas y editores
.DS_Store
Thumbs.db
.idea/

# De .vscode se ignora todo menos las tareas y guiones que reproducen las
# evidencias TDD, para que docs/evidencias-visuales.md se pueda repetir tal
# cual. Se excluye el contenido y no la carpeta: Git no desciende a un
# directorio ignorado, asi que las excepciones de adentro no tendrian efecto.
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/evidencias/

# Variables y secretos
.env
.env.*
!.env.example

# JavaScript
node_modules/
dist/
coverage/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/

# PHP / Laravel
vendor/
storage/*.key
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
bootstrap/cache/*.php

# Bases de datos locales
*.sqlite
*.sqlite3
*.db

# Configuracion local de asistentes de IA
.claude/
.agents/
.mcp.json
CLAUDE.md
AGENTS.md
boost.json
